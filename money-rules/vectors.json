{
  "_comment": "Golden vectors for the platform fee rule, shared by konfirm-backend (src/common/money-rules.spec.ts) and the reconciler (reconciler/src/money.rs). A change to the rule must change these vectors. Amounts and fees are in asset units, as decimal strings with up to 7 decimals. fee = floor(amount * bps / 10000) to a stroop, raised to floor when the fee is positive. A zero amount or a zero rate charges nothing.",
  "vectors": [
    { "name": "basic 10 bps", "amount": "10", "bps": 10, "floor": "0", "fee": "0.0100000" },
    { "name": "rounds down, never up", "amount": "0.0000019", "bps": 10, "floor": "0", "fee": "0.0000000" },
    { "name": "fractional stroop truncates", "amount": "1", "bps": 3, "floor": "0", "fee": "0.0003000" },
    { "name": "zero rate charges nothing", "amount": "100", "bps": 0, "floor": "0", "fee": "0.0000000" },
    { "name": "zero amount charges nothing", "amount": "0", "bps": 100, "floor": "0.05", "fee": "0.0000000" },
    { "name": "large amount, fraction dropped", "amount": "1234.5678901", "bps": 1, "floor": "0", "fee": "0.1234567" },
    { "name": "floor applies to a small fee", "amount": "0.01", "bps": 100, "floor": "0.05", "fee": "0.0500000" },
    { "name": "floor does not reduce a larger fee", "amount": "10", "bps": 100, "floor": "0.05", "fee": "0.1000000" },
    { "name": "exact floor boundary", "amount": "5", "bps": 100, "floor": "0.05", "fee": "0.0500000" },
    { "name": "one stroop above the floor boundary", "amount": "5.0000001", "bps": 100, "floor": "0.05", "fee": "0.0500000" },
    { "name": "XLM smallest unit at full rate", "asset": "XLM", "amount": "0.0000001", "bps": 10000, "floor": "0", "fee": "0.0000001" },
    { "name": "XLM fractional rate truncates to stroops", "asset": "XLM", "amount": "0.0000009", "bps": 5000, "floor": "0", "fee": "0.0000004" },
    { "name": "USDC cent remains exact at full rate", "asset": "USDC", "amount": "0.01", "bps": 10000, "floor": "0", "fee": "0.0100000" },
    { "name": "USDC cent creates sub-cent fee precision", "asset": "USDC", "amount": "0.01", "bps": 5000, "floor": "0", "fee": "0.0050000" },
    { "name": "EURC precision boundary is asset independent", "asset": "EURC", "amount": "0.03", "bps": 3333, "floor": "0", "fee": "0.0099990" },
    { "name": "fee one stroop below floor", "amount": "4.9999999", "bps": 100, "floor": "0.05", "fee": "0.0500000" },
    { "name": "fee one stroop above floor", "amount": "5.0001", "bps": 100, "floor": "0.05", "fee": "0.0500010" }
  ]
